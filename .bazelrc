# Prebuilt protoc instead of compiling protobuf from C++ source for the Scalac worker.
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

build --java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21

build:ast --extra_toolchains=//toolchains:ast
build:high_level --extra_toolchains=//toolchains:high_level
build:off --extra_toolchains=//toolchains:off

try-import %workspace%/.bazelrc.user